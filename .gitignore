# Rust
/target/
**/*.rs.bk

# Node
node_modules/
.pnpm-store/

# wasm-pack output. NEVER a pnpm workspace member (§2); the hand-written @tetravox/wasm wraps it.
# `packages/wasm/pkg/tvx_wasm.d.ts` is the one committed file in here (§12.3 item 4).
packages/wasm/pkg/*
!packages/wasm/pkg/tvx_wasm.d.ts

# Build output
dist/
out/
release/
*.tsbuildinfo

# Test output
test-results/
playwright-report/
blob-report/
packages/engine/test/golden/**/*-actual.png
packages/engine/test/golden/**/*-diff.png

# Editors / OS
.DS_Store
.vscode/
.idea/

# VitePress docs site (website/) — src/ and the shots/media/gallery it copies into public/ are
# regenerated by website/scripts/sync.mjs and gallery.mjs on every dev/build; never hand-edited.
website/src/
website/public/shots/
website/public/media/
website/public/gallery/
website/.vitepress/cache/
website/.vitepress/dist/

# The reference renderer's generated CT and any other large derived test volumes (scripts/reference).
testdata/generated/

# Python bytecode (scripts/reference and scripts/*.py).
__pycache__/
*.pyc

# Regenerated by the real-data Playwright specs (mesh-real, derived-r4).
# The durable figures live in docs/BENCHMARKS.md.
docs/benchmarks/
# Reference imaging data, fetched by `scripts/fetch-data.sh` (see data/README.md). ~1 GB of it, most
# of it two meshes: it is what the examples read, and it is not something a clone should carry.
/data/ernie/

# Other Claude sessions check out agent worktrees here; never tracked, never touched.
.claude/

/coverage/
