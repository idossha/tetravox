source "https://rubygems.org"

# Web server for Jekyll (removed from Ruby 3.0+)
gem "webrick", "~> 1.8"

# Minimal Jekyll setup. No theme gem — every layout/include is authored directly
# under _layouts/ and _includes/, so nothing pulls in a theme's transitive plugins.
gem "jekyll", "~> 3.9.0"
gem "kramdown", "~> 2.3.0"
gem "kramdown-parser-gfm", "~> 1.1.0"

# Basic plugins only
group :jekyll_plugins do
  gem "jekyll-seo-tag", "~> 2.6"
  gem "jekyll-sitemap", "~> 1.3"
end
