{
  "name": "tetravox",
  "version": "0.3.6",
  "private": true,
  "type": "module",
  "description": "High-performance NIfTI + mesh viewer. See docs/ARCHITECTURE.md.",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "wasm": "bash scripts/build-wasm.sh",
    "build": "pnpm run wasm && pnpm -r --if-present run build",
    "test": "cargo test --workspace && pnpm run wasm && vitest run",
    "e2e": "pnpm -r --if-present run e2e",
    "dev": "pnpm --filter @tetravox/app run dev",
    "package": "pnpm run build && bash scripts/ensure-icons.sh && pnpm --filter @tetravox/app run package",
    "package:linux": "bash scripts/package-linux.sh",
    "smoke": "node scripts/smoke-artefact.mjs",
    "typecheck": "pnpm run wasm && pnpm -r --if-present run typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ],
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.4.0",
    "electron": "^44.0.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
