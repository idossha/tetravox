{
  // The embed build. It compiles this package's own sources plus, transitively, the app renderer
  // they import — so `../app/src/renderer/src/env.d.ts` has to be included by hand: it carries the
  // `Window.tetravox` / `Window.__tetravox` globals the shell's files declare, and without it every
  // one of those reads is an error here while passing in `packages/app`'s own typecheck.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    // `node` is here for `vite.config.ts` and `scripts/`, which are the only files that may use it.
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "vite.config.ts",
    "../app/src/renderer/src/env.d.ts",
    // The E2E uses `packages/engine`'s §11 helpers rather than a second copy of the golden policy
    // (AGENTS.md rule 1 is one rule, not one per package), and those read `window.__tvxRender` —
    // declared for the engine's own test pages here. Included by hand for the same reason the app's
    // `env.d.ts` above is: a global declared in a file nothing in this package imports.
    "../engine/test/pages/types.ts"
  ]
}
