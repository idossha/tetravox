{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://tetravox.dev/schema/embed-protocol-v1.json",
  "title": "Tetravox embed host protocol (envelope tvx 1, protocol 2)",
  "description": "Every message between a host page and an embedded Tetravox. See docs/EMBED.md. TWO NUMBERS: `tvx` is the envelope discriminator and stays 1 (it moves only for a BREAKING change); `ready.version`, and the tarball manifest's `protocol`, are the feature level and are 2. The feature level is NOT the release version: the embed tarball carries the repository version (0.3.11 and up), and one repository version implements exactly one protocol. The protocol is ADDITIVE-ONLY: types and optional fields may be added; nothing may be removed, renamed, made required, or given a new meaning. Ignore a `type` you do not know.",
  "type": "object",
  "properties": {
    "tvx": {
      "const": 1,
      "description": "The envelope discriminator. Always 1. NOT the protocol version — see `ready.version`."
    },
    "type": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "description": "Correlation token. A reply carries the id of its request."
    }
  },
  "required": ["tvx", "type"],
  "oneOf": [
    {
      "$ref": "#/definitions/HostMessage"
    },
    {
      "$ref": "#/definitions/EmbedMessage"
    }
  ],
  "definitions": {
    "HostMessage": {
      "description": "Host -> embed.",
      "oneOf": [
        {
          "type": "object",
          "title": "hello",
          "description": "Ask for `ready`. The embed also posts `ready` unprompted on boot.",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "hello"
            },
            "id": {
              "type": "string"
            }
          },
          "required": ["tvx", "type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "load",
          "description": "Replace the scene. Replies `loaded` or `error` with this message's id.",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "load"
            },
            "id": {
              "type": "string"
            },
            "scene": {
              "$ref": "#/definitions/EmbedViewSpec"
            },
            "baseUrl": {
              "type": "string",
              "description": "Base for a relative DatasetRef.path. Defaults to the embed document's own baseURI."
            }
          },
          "required": ["tvx", "type", "scene"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "setTheme",
          "description": "",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "setTheme"
            },
            "id": {
              "type": "string"
            },
            "theme": {
              "enum": ["light", "dark"]
            }
          },
          "required": ["tvx", "type", "theme"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "setLayout",
          "description": "Choose the pane arrangement. `kind` is one of ARCHITECTURE.md 4.5's seven LayoutKinds, or one of four names that name a view rather than a grid: '3d' (the 3-D pane alone) and 'axial'/'coronal'/'sagittal' (that slice pane alone). A kind this build does not know is answered with an `error`, never acted on.",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "setLayout"
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "1x1",
                "1x3",
                "1x3-horizontal",
                "2x2",
                "3d-only",
                "1+3",
                "3d+1",
                "3d",
                "axial",
                "coronal",
                "sagittal"
              ]
            }
          },
          "required": ["tvx", "type", "kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "setCursor",
          "description": "",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "setCursor"
            },
            "id": {
              "type": "string"
            },
            "world": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3,
              "description": "World RAS millimetres."
            }
          },
          "required": ["tvx", "type", "world"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "setLayerVisible",
          "description": "",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "setLayerVisible"
            },
            "id": {
              "type": "string"
            },
            "layerId": {
              "type": "string"
            },
            "visible": {
              "type": "boolean"
            }
          },
          "required": ["tvx", "type", "layerId", "visible"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "setLayerOpacity",
          "description": "",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "setLayerOpacity"
            },
            "id": {
              "type": "string"
            },
            "layerId": {
              "type": "string"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": ["tvx", "type", "layerId", "opacity"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "updateLayer",
          "description": "",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "updateLayer"
            },
            "id": {
              "type": "string"
            },
            "layerId": {
              "type": "string"
            },
            "patch": {
              "type": "object",
              "description": "Any subset of the layer's fields (ARCHITECTURE.md 4.4)."
            }
          },
          "required": ["tvx", "type", "layerId", "patch"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "setActiveLayer",
          "description": "",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "setActiveLayer"
            },
            "id": {
              "type": "string"
            },
            "layerId": {
              "type": ["string", "null"]
            }
          },
          "required": ["tvx", "type", "layerId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "screenshot",
          "description": "Capture a PNG. `id` is required: the reply carries megabytes of base64.",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "screenshot"
            },
            "id": {
              "type": "string"
            },
            "target": {
              "enum": ["view", "grid"],
              "default": "grid"
            },
            "viewId": {
              "type": "string",
              "description": "Required when target is 'view'."
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["tvx", "type", "id"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "serialize",
          "description": "Ask for the live scene as a ViewSpec. Replies `scene`.",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "serialize"
            },
            "id": {
              "type": "string"
            }
          },
          "required": ["tvx", "type", "id"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "probe",
          "description": "Probe every layer at a world point without moving the cursor.",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "probe"
            },
            "id": {
              "type": "string"
            },
            "world": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": ["tvx", "type", "id", "world"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "focus",
          "description": "Give the viewer keyboard focus; the key map is dead in an unfocused iframe.",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "focus"
            },
            "id": {
              "type": "string"
            }
          },
          "required": ["tvx", "type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "reset",
          "description": "Unload everything and terminate every dataset worker.",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "reset"
            },
            "id": {
              "type": "string"
            }
          },
          "required": ["tvx", "type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "setPointTool",
          "description": "Arm section 7.5's point tool on one points layer, or disarm with layerId: null. Arming materialises `p<index>` ids on points that carry none (a `layers` event follows) and turns measure mode off.",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "setPointTool"
            },
            "id": {
              "type": "string"
            },
            "layerId": {
              "type": ["string", "null"],
              "description": "A LIVE layer id, from loaded.layers. null disarms."
            },
            "mode": {
              "enum": ["select", "place"],
              "description": "Default 'select'. In 'place' EVERY click appends a point, with no hit test."
            },
            "template": {
              "type": "object",
              "description": "What a placed point starts as; position and id are the engine's.",
              "properties": {
                "color": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "radiusMm": {
                  "type": "number"
                },
                "group": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "required": ["tvx", "type", "layerId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "setPointSelection",
          "description": "Select a point by id, or clear with pointId: null. An id that is not in the live points[] clears the selection with a pointTool event whose reason is 'selection'. NOT the same as points[].state.",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "setPointSelection"
            },
            "id": {
              "type": "string"
            },
            "layerId": {
              "type": "string"
            },
            "pointId": {
              "type": ["string", "null"]
            }
          },
          "required": ["tvx", "type", "layerId", "pointId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "setPoints",
          "description": "Replace a points layer's points[] wholesale. This is the update that runs the state -> colour resolution; an `updateLayer` with a points patch does not.",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "setPoints"
            },
            "id": {
              "type": "string"
            },
            "layerId": {
              "type": "string"
            },
            "points": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/EmbedPoint"
              }
            }
          },
          "required": ["tvx", "type", "layerId", "points"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "setPickEvents",
          "description": "Turn the `pick` event on or off. OFF by default: with it off, the message stream a host receives from a protocol-2 build is the one a protocol-1 build sends.",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "setPickEvents"
            },
            "id": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "required": ["tvx", "type", "enabled"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "getCamera",
          "description": "Ask for the 3-D camera. Replies `camera` with this message's id.",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "getCamera"
            },
            "id": {
              "type": "string"
            }
          },
          "required": ["tvx", "type", "id"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "setCamera",
          "description": "Move the 3-D camera: an anatomical preset, a patch, or both (preset first, then patch). A PATCH, not a whole Camera3D: near/far are derived from the fit radius and writing all seven fields carries a stale clip range back with a restored pose. With an id, replies `camera`.",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "setCamera"
            },
            "id": {
              "type": "string"
            },
            "preset": {
              "oneOf": [
                {
                  "enum": [1, 2, 3, 4, 5, 6]
                },
                {
                  "enum": ["A", "P", "L", "R", "S", "I"]
                }
              ],
              "description": "Section 7.5's six: anterior, posterior, left, right, superior, inferior."
            },
            "patch": {
              "$ref": "#/definitions/Camera3D"
            }
          },
          "required": ["tvx", "type"],
          "additionalProperties": false
        }
      ]
    },
    "EmbedMessage": {
      "description": "Embed -> host.",
      "oneOf": [
        {
          "type": "object",
          "title": "ready",
          "description": "Posted on boot and in reply to `hello`. Branch on caps.webgl2.",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "ready"
            },
            "id": {
              "type": "string"
            },
            "version": {
              "const": 2,
              "description": "The protocol feature level this build implements. NOT the envelope `tvx`."
            },
            "caps": {
              "type": "object",
              "properties": {
                "webgl2": {
                  "type": "boolean"
                },
                "renderer": {
                  "type": "string"
                },
                "norm16": {
                  "type": "boolean"
                }
              },
              "required": ["webgl2"],
              "additionalProperties": false
            }
          },
          "required": ["tvx", "type", "version", "caps"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "status",
          "description": "",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "status"
            },
            "id": {
              "type": "string"
            },
            "phase": {
              "enum": ["idle", "loading", "ready", "error", "no-webgl2"]
            },
            "message": {
              "type": "string"
            }
          },
          "required": ["tvx", "type", "phase"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "progress",
          "description": "",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "progress"
            },
            "id": {
              "type": "string"
            },
            "datasetId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "phase": {
              "type": "string"
            },
            "done": {
              "type": "number"
            },
            "total": {
              "type": "number",
              "description": "0 when the phase cannot say."
            }
          },
          "required": ["tvx", "type", "datasetId", "name", "phase", "done", "total"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "loaded",
          "description": "The ids here are the LIVE ones, not the ids the host sent: Engine.load re-adds every dataset.",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "loaded"
            },
            "id": {
              "type": "string"
            },
            "datasets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": ["volume", "mesh"]
                  },
                  "bytes": {
                    "type": "number"
                  }
                },
                "required": ["id", "name", "kind"],
                "additionalProperties": false
              }
            },
            "layers": {
              "type": "array",
              "items": {
                "type": "object",
                "description": "An engine Layer (ARCHITECTURE.md 4.4), verbatim."
              }
            }
          },
          "required": ["tvx", "type", "datasets", "layers"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "layers",
          "description": "",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "layers"
            },
            "id": {
              "type": "string"
            },
            "layers": {
              "type": "array",
              "items": {
                "type": "object",
                "description": "An engine Layer (ARCHITECTURE.md 4.4), verbatim."
              }
            }
          },
          "required": ["tvx", "type", "layers"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "cursor",
          "description": "Throttled to 30 Hz.",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "cursor"
            },
            "id": {
              "type": "string"
            },
            "world": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "mni": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "tkr": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "space": {
              "type": "string",
              "description": "Stable key of the coordinate bar's current space."
            }
          },
          "required": ["tvx", "type", "world", "space"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "probe",
          "description": "",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "probe"
            },
            "id": {
              "type": "string"
            },
            "result": {
              "type": "object",
              "description": "An engine ProbeResult: world, optional mni/tkr, and rows."
            }
          },
          "required": ["tvx", "type", "id", "result"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "screenshot",
          "description": "",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "screenshot"
            },
            "id": {
              "type": "string"
            },
            "dataUrl": {
              "type": "string",
              "pattern": "^data:image/png;base64,"
            }
          },
          "required": ["tvx", "type", "id", "dataUrl"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "scene",
          "description": "",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "scene"
            },
            "id": {
              "type": "string"
            },
            "spec": {
              "type": "object",
              "description": "A complete ViewSpec v2 (ARCHITECTURE.md 4.6)."
            }
          },
          "required": ["tvx", "type", "id", "spec"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "error",
          "description": "",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "error"
            },
            "id": {
              "type": "string"
            },
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": ["tvx", "type", "message"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "pick",
          "description": "What a click landed on — one per left press, and only while setPickEvents has enabled it. Branch on `kind`. The mesh rows of `probe` are at most one round trip stale (ARCHITECTURE.md 4.7); the volume rows, `label` among them, are exact.",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "pick"
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "enum": ["point", "tri", "tet", "slice", "cursor"]
            },
            "world": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "viewId": {
              "type": "string"
            },
            "layerId": {
              "type": "string",
              "description": "The layer that owned the pixel; absent for 'cursor'."
            },
            "pointId": {
              "type": "string",
              "description": "Present for kind 'point' only."
            },
            "elementId": {
              "type": "number",
              "description": "Gmsh element number, or the plane index for a slice quad."
            },
            "label": {
              "type": "object",
              "description": "The label volume value under the click.",
              "properties": {
                "id": {
                  "type": "number"
                },
                "name": {
                  "type": "string"
                },
                "layerId": {
                  "type": "string"
                }
              },
              "required": ["id", "layerId"],
              "additionalProperties": false
            },
            "tag": {
              "type": "object",
              "description": "A mesh's tissue tag under the click.",
              "properties": {
                "id": {
                  "type": "number"
                },
                "name": {
                  "type": "string"
                },
                "layerId": {
                  "type": "string"
                }
              },
              "required": ["id", "layerId"],
              "additionalProperties": false
            },
            "modifiers": {
              "type": "object",
              "properties": {
                "shift": {
                  "type": "boolean"
                },
                "ctrl": {
                  "type": "boolean"
                },
                "alt": {
                  "type": "boolean"
                },
                "meta": {
                  "type": "boolean"
                }
              },
              "required": ["shift", "ctrl", "alt", "meta"],
              "additionalProperties": false
            },
            "probe": {
              "type": "object",
              "description": "ProbeResult at `world` — ARCHITECTURE.md 4.7."
            }
          },
          "required": ["tvx", "type", "kind", "world", "modifiers", "probe"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "pointTool",
          "description": "Section 7.5's point tool did something — the engine's PointToolEvent, forwarded unchanged. Only fires while a tool is armed. A plain select-mode click emits `selected` AND a zero-length `dragEnd`: compare positions before recording an edit.",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "pointTool"
            },
            "id": {
              "type": "string"
            },
            "event": {
              "type": "object",
              "properties": {
                "layerId": {
                  "type": "string"
                },
                "kind": {
                  "enum": ["placed", "selected", "dragEnd", "cleared"]
                },
                "pointId": {
                  "type": ["string", "null"]
                },
                "index": {
                  "type": "number"
                },
                "world": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "viewId": {
                  "type": "string"
                },
                "reason": {
                  "enum": ["esc", "measure", "load", "layer", "host", "selection"],
                  "description": "`cleared` only. 'selection' means only the selection went and the tool is still armed."
                }
              },
              "required": ["layerId", "kind", "pointId", "index"]
            }
          },
          "required": ["tvx", "type", "event"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "camera",
          "description": "The 3-D camera — the reply to getCamera, and to a setCamera that carried an id. Never posted unprompted: an orbit would be a message per frame.",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "camera"
            },
            "id": {
              "type": "string"
            },
            "camera": {
              "$ref": "#/definitions/Camera3D"
            }
          },
          "required": ["tvx", "type", "camera"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "ack",
          "description": "Done. The reply to a host message that changes something and returns no value — setPointTool, setPointSelection, setPoints. Sent ONLY when the request carried an id, because the id is the whole message. Not an echo of `layers`: `layers` also fires for a user's own click in the layer panel, and a host correlating on it would treat someone else's edit as its own reply.",
          "properties": {
            "tvx": {
              "const": 1
            },
            "type": {
              "const": "ack"
            },
            "id": {
              "type": "string",
              "description": "The id of the request this answers. Required."
            },
            "of": {
              "enum": [
                "hello",
                "load",
                "setTheme",
                "setLayout",
                "setCursor",
                "setLayerVisible",
                "setLayerOpacity",
                "updateLayer",
                "setActiveLayer",
                "screenshot",
                "serialize",
                "probe",
                "focus",
                "reset",
                "setPointTool",
                "setPointSelection",
                "setPoints",
                "setPickEvents",
                "getCamera",
                "setCamera"
              ],
              "description": "The `type` of the request this answers, so a host with several in flight need keep no table of its own."
            }
          },
          "required": ["tvx", "type", "id", "of"],
          "additionalProperties": false
        }
      ]
    },
    "EmbedDatasetRef": {
      "type": "object",
      "description": "A DatasetRef as a host can write one. `fingerprint` and `absPath` of the full ARCHITECTURE.md 4.6 form are omitted: both are computed from bytes or a filesystem an embed does not have.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": ["volume", "mesh"]
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "Absolute http(s) URL, used as-is; or relative/root-relative, resolved against LoadMessage.baseUrl (default: the embed document's baseURI)."
        },
        "fingerprint": {
          "type": "string",
          "description": "Optional; '' is exact for an embed."
        },
        "sidecars": {
          "type": "object",
          "description": "Resolved against the DATASET's own URL, per ARCHITECTURE.md 4.6.",
          "properties": {
            "lut": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "required": ["path"]
            },
            "opt": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "required": ["path"]
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["id", "kind", "name", "path"],
      "additionalProperties": false
    },
    "EmbedViewSpec": {
      "type": "object",
      "description": "A ViewSpec v2 as a host can write one. Only `datasets` and `layers` are required; slices, view3d, layout, cursor, radiological, background, lighting, annotations and transparency are filled from the engine's own empty scene when absent. Any other ViewSpec v2 field may be sent and is passed through.",
      "properties": {
        "version": {
          "enum": [1, 2]
        },
        "datasets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EmbedDatasetRef"
          }
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "A SerializableLayer. Minimum: id, datasetId, kind. Every other field falls back to the engine's per-dataset default.",
            "properties": {
              "id": {
                "type": "string"
              },
              "datasetId": {
                "type": "string"
              },
              "kind": {
                "enum": ["volume", "mesh"]
              }
            },
            "required": ["id", "datasetId", "kind"]
          }
        },
        "activeLayerId": {
          "type": ["string", "null"]
        }
      },
      "required": ["datasets", "layers"]
    },
    "Camera3D": {
      "type": "object",
      "description": "ARCHITECTURE.md 4.5. `rotation` is a quaternion [x, y, z, w]. `near`/`far` are derived from the fit radius (7.2) — send them only if you mean to override the engine.",
      "properties": {
        "target": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "distance": {
          "type": "number"
        },
        "rotation": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "fovYDeg": {
          "type": "number"
        },
        "orthographic": {
          "type": "boolean"
        },
        "near": {
          "type": "number"
        },
        "far": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "EmbedPoint": {
      "type": "object",
      "description": "One point of a points layer. The field names are ARCHITECTURE.md 4.4's own; `state` is the one addition, and it resolves to a colour before the engine sees the layer. Unlisted fields pass through.",
      "properties": {
        "id": {
          "type": "string",
          "description": "The point's identity — what pick and setPointSelection name it by. Optional; the engine mints `p<index>` for a point with none, and an index moves when a point is deleted."
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "World-RAS millimetres."
        },
        "name": {
          "type": "string",
          "description": "Drawn by labelMode 'names'; names the probe row."
        },
        "state": {
          "enum": ["idle", "selected", "disabled"],
          "description": "Resolved to a colour from the layer stateColors, or the defaults. An explicit `color` wins. NOT the tool selection: any number of points may be selected here."
        },
        "color": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "radiusMm": {
          "type": "number"
        },
        "group": {
          "type": "string",
          "description": "Which set the point belongs to — an electrode, a montage, a parcel. Uninterpreted."
        },
        "ordinal": {
          "type": "number"
        },
        "value": {
          "type": "number"
        }
      },
      "required": ["position"]
    }
  }
}
