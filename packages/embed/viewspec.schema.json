{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://tetravox.dev/schema/embed-viewspec-v2.json",
  "title": "Tetravox ViewSpec v2 — the host-facing subset",
  "description": "THE HOST-FACING SUBSET of ARCHITECTURE.md 4.6's ViewSpec, hand-maintained. It covers what a host writes by hand and validates it strictly enough to catch a typo; it is NOT the full spec. Two differences from a *.tetravox.json on disk. (1) `datasets[].path` is a URL, not a path relative to a scene file — absolute http(s) is used as-is, anything else is resolved against LoadMessage.baseUrl. (2) Only `datasets` and `layers` are required: the nine view fields the engine requires (slices, view3d, layout, cursor, radiological, background, lighting, annotations, transparency) are filled from the engine's own empty scene when a host omits them, and a layer needs only id, datasetId and kind — every other field falls back to the engine's per-dataset default. A third layer kind, `points`, arrived with protocol 2 and is written inline — there is no points file to name. Fields not listed here are still accepted and passed through unchanged; see ARCHITECTURE.md 4.4 for the complete layer model.",
  "type": "object",
  "properties": {
    "version": {
      "enum": [1, 2],
      "description": "Optional. Defaults to this build's SCENE_VERSION."
    },
    "datasets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/DatasetRef"
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/VolumeLayer"
          },
          {
            "$ref": "#/definitions/MeshLayer"
          },
          {
            "$ref": "#/definitions/PointsLayer"
          }
        ]
      }
    },
    "activeLayerId": {
      "type": ["string", "null"],
      "description": "One of the layers' `id`s, or null."
    },
    "cursor": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "World RAS mm. Optional."
    },
    "radiological": {
      "type": "boolean"
    },
    "layout": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["2x2", "1+3", "3d+1", "3d", "axial", "coronal", "sagittal"]
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "background": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "theme": {
      "enum": ["system", "light", "dark"]
    }
  },
  "required": ["datasets", "layers"],
  "definitions": {
    "DatasetRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Host-chosen, and referenced by layers[].datasetId."
        },
        "kind": {
          "enum": ["volume", "mesh"]
        },
        "name": {
          "type": "string",
          "description": "What the layer panel calls it."
        },
        "path": {
          "type": "string",
          "description": "Absolute http(s) URL, or relative/root-relative resolved against LoadMessage.baseUrl (default: the embed document's baseURI)."
        },
        "fingerprint": {
          "type": "string",
          "description": "Optional. '' is exact for an embed: it is computed in the worker over bytes a host has never seen, and identifies a file only for a relocate dialog an embed does not have."
        },
        "sidecars": {
          "type": "object",
          "description": "Resolved against the DATASET's own URL, not the page: a sidecar travels with the file it describes (ARCHITECTURE.md 4.6). Reading one is best-effort — a missing sidecar is a missing table, never a failed load.",
          "properties": {
            "lut": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "required": ["path"],
              "description": "A label volume's colour/name table, e.g. final_tissues_LUT.txt."
            },
            "opt": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "required": ["path"],
              "description": "A Gmsh .msh.opt — the only source of tissue names for a mesh with no $PhysicalNames."
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["id", "kind", "name", "path"]
    },
    "VolumeLayer": {
      "type": "object",
      "title": "VolumeLayer",
      "properties": {
        "id": {
          "type": "string",
          "description": "Host-chosen. NOT the id you get back: Engine.load reassigns every id."
        },
        "datasetId": {
          "type": "string",
          "description": "Must match a DatasetRef.id in `datasets`."
        },
        "kind": {
          "const": "volume"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pickable": {
          "type": "boolean"
        },
        "showColorbar": {
          "type": "boolean"
        },
        "colormap": {
          "enum": [
            "gray",
            "viridis",
            "plasma",
            "inferno",
            "magma",
            "cividis",
            "turbo",
            "jet",
            "hot",
            "cool",
            "bone",
            "coolwarm",
            "bwr",
            "freesurfer-heat",
            "blue-cyan"
          ]
        },
        "scale": {
          "description": "ARCHITECTURE.md 4.2. Omit it: a volume gets its own 2nd-98th percentile window, and a mesh field layer is windowed from that field's stats by the embed.",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "linear"
                },
                "lo": {
                  "type": "number"
                },
                "hi": {
                  "type": "number"
                }
              },
              "required": ["kind", "lo", "hi"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "heat"
                },
                "min": {
                  "type": "number"
                },
                "mid": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "truncate": {
                  "type": "boolean"
                },
                "inverse": {
                  "type": "boolean"
                },
                "negative": {
                  "enum": ["mirror", "hide", "separate"]
                }
              },
              "required": ["kind", "min", "mid", "max"],
              "additionalProperties": false
            }
          ]
        },
        "threshold": {
          "type": "object",
          "description": "JSON has no infinity: an unset bound is written as null and read back as the infinity it stands for.",
          "properties": {
            "lo": {
              "type": ["number", "null"]
            },
            "hi": {
              "type": ["number", "null"]
            },
            "symmetric": {
              "type": "boolean"
            },
            "mode": {
              "enum": ["hide", "clamp"]
            },
            "softEdge": {
              "type": "number",
              "description": "Alpha ramp width as a fraction of hi-lo; 0 is a hard discard."
            }
          },
          "additionalProperties": false
        },
        "volumeIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "Which 3D volume of a 4D file."
        },
        "interpolation": {
          "enum": ["nearest", "linear"],
          "description": "Forced to nearest for a label volume."
        },
        "labelMode": {
          "enum": ["fill", "outline"],
          "description": "Label volumes only."
        },
        "outlineWidthPx": {
          "type": "number"
        },
        "visibleLabels": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Absent means all."
        },
        "showIn3D": {
          "type": "boolean"
        },
        "precision": {
          "enum": ["auto", "r16", "r32f"]
        }
      },
      "required": ["id", "datasetId", "kind"]
    },
    "MeshLayer": {
      "type": "object",
      "title": "MeshLayer",
      "properties": {
        "id": {
          "type": "string",
          "description": "Host-chosen. NOT the id you get back: Engine.load reassigns every id."
        },
        "datasetId": {
          "type": "string",
          "description": "Must match a DatasetRef.id in `datasets`."
        },
        "kind": {
          "const": "mesh"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pickable": {
          "type": "boolean"
        },
        "showColorbar": {
          "type": "boolean"
        },
        "colormap": {
          "enum": [
            "gray",
            "viridis",
            "plasma",
            "inferno",
            "magma",
            "cividis",
            "turbo",
            "jet",
            "hot",
            "cool",
            "bone",
            "coolwarm",
            "bwr",
            "freesurfer-heat",
            "blue-cyan"
          ]
        },
        "scale": {
          "description": "ARCHITECTURE.md 4.2. Omit it: a volume gets its own 2nd-98th percentile window, and a mesh field layer is windowed from that field's stats by the embed.",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "linear"
                },
                "lo": {
                  "type": "number"
                },
                "hi": {
                  "type": "number"
                }
              },
              "required": ["kind", "lo", "hi"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "heat"
                },
                "min": {
                  "type": "number"
                },
                "mid": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "truncate": {
                  "type": "boolean"
                },
                "inverse": {
                  "type": "boolean"
                },
                "negative": {
                  "enum": ["mirror", "hide", "separate"]
                }
              },
              "required": ["kind", "min", "mid", "max"],
              "additionalProperties": false
            }
          ]
        },
        "threshold": {
          "type": "object",
          "description": "JSON has no infinity: an unset bound is written as null and read back as the infinity it stands for.",
          "properties": {
            "lo": {
              "type": ["number", "null"]
            },
            "hi": {
              "type": ["number", "null"]
            },
            "symmetric": {
              "type": "boolean"
            },
            "mode": {
              "enum": ["hide", "clamp"]
            },
            "softEdge": {
              "type": "number",
              "description": "Alpha ramp width as a fraction of hi-lo; 0 is a hard discard."
            }
          },
          "additionalProperties": false
        },
        "colorMode": {
          "enum": ["solid", "tag", "field"]
        },
        "solidColor": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "field": {
          "type": "object",
          "description": "Which field colours the mesh. `source` is where it lives in the file.",
          "properties": {
            "source": {
              "enum": ["node", "elm"]
            },
            "name": {
              "type": "string"
            },
            "component": {
              "description": "'mag' or a 0-based component index for a vector field."
            }
          },
          "required": ["source", "name"]
        },
        "tagStyle": {
          "type": "object",
          "description": "Per-tag visibility and opacity, keyed by the tag NUMBER as a string. Tags are not contiguous and a SimNIBS simulation mesh adds electrode/gel tags in the 101/501/1101/2101 ranges.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "visible": {
                "type": "boolean"
              },
              "opacity": {
                "type": "number"
              }
            }
          }
        },
        "clip": {
          "type": "object",
          "properties": {
            "planes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "plane": {
                    "type": "object",
                    "properties": {
                      "normal": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 3,
                        "maxItems": 3
                      },
                      "offset": {
                        "type": "number"
                      }
                    },
                    "required": ["normal", "offset"]
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "followCursor": {
                    "type": "boolean",
                    "description": "The plane tracks the crosshair."
                  }
                },
                "required": ["plane"]
              }
            },
            "caps": {
              "type": "boolean",
              "description": "Fill the cut with exact cap geometry."
            },
            "capColorMode": {
              "enum": ["inherit", "solid"]
            }
          }
        },
        "contoursIn2D": {
          "type": "boolean",
          "description": "Draw the mesh as outlines in the slice panes."
        },
        "contourWidthPx": {
          "type": "number"
        },
        "contourColor": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "fillIn2D": {
          "type": "boolean"
        },
        "edges": {
          "type": "object",
          "properties": {
            "surface": {
              "type": "boolean"
            },
            "caps": {
              "type": "boolean"
            }
          }
        },
        "edgeColor": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "edgeWidthPx": {
          "type": "number"
        },
        "flatShading": {
          "type": "boolean"
        },
        "faceMode": {
          "enum": ["cull", "both"]
        }
      },
      "required": ["id", "datasetId", "kind"]
    },
    "PointsLayer": {
      "type": "object",
      "title": "PointsLayer",
      "description": "A points layer written INLINE (protocol 2). There is no points file an embed could serve, so the coordinates arrive with the layer: `datasetId` names a dataset already in this spec — the volume the points sit over — exactly as the sEEG contact editor hangs its contacts off the CT they were localised on. `state` and `labelMode` are this protocol's own vocabulary and are resolved before the engine sees the layer; everything else is ARCHITECTURE.md 4.4's PointsLayer verbatim.",
      "properties": {
        "id": {
          "type": "string"
        },
        "datasetId": {
          "type": "string",
          "description": "A dataset in THIS spec. Points need no file, but a layer needs a carrier (4.4)."
        },
        "kind": {
          "const": "points"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pickable": {
          "type": "boolean",
          "description": "Whether 7.2.3's id pass answers for this layer. The point tool hit-tests regardless."
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Point"
          }
        },
        "shape": {
          "enum": ["sphere", "dot"],
          "description": "'sphere' (default) is radiusMm in world mm; 'dot' is a constant screen size in BOTH the 2-D slice panes and the 3-D pane (the 3-D half arrived in Tetravox 0.3.12; before it, a 3-D pane drew millimetre spheres whatever this said). A 3-D dot is flat, not shaded."
        },
        "radiusMm": {
          "type": "number",
          "description": "Default 4 mm, about an EEG electrode."
        },
        "color": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "0..1 RGBA — every point with neither its own colour nor a resolved state."
        },
        "labelMode": {
          "enum": ["none", "names", "labels"],
          "description": "Default 'none'. 'names' draws each point's own name at its own position; 'labels' draws the layer's free-standing labels[] anchors, which only a parsed Gmsh view has. There is no 'hover': the engine draws no hover text, and a mode that silently did nothing would be worse than its absence."
        },
        "stateColors": {
          "type": "object",
          "description": "What each points[].state paints, when that point carries no explicit color. Absent states keep the default: idle -> the layer colour, selected -> [1, 0.8, 0.2, 1] (rgb 255,204,51), disabled -> [0.6, 0.6, 0.6, 1] (rgb 153,153,153). `idle` was accepted and ignored before Tetravox 0.3.12; from 0.3.12 an idle point with no color of its own takes it.",
          "properties": {
            "idle": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            },
            "selected": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            },
            "disabled": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            }
          },
          "additionalProperties": false
        },
        "offPlaneOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How visible a point is in a 2-D pane it is not on. 0 or absent is 7.2's hard cull — right for a scalp net, wrong for a depth electrode, whose shaft no single slice contains."
        },
        "dotRadiusPx": {
          "type": "number",
          "description": "shape 'dot' only: the screen radius in CSS pixels. Absent is 4."
        }
      },
      "required": ["id", "datasetId", "kind", "points"]
    },
    "Point": {
      "type": "object",
      "title": "Point",
      "description": "One point. Unlisted fields are accepted and passed through — 4.4 is the complete model.",
      "properties": {
        "id": {
          "type": "string",
          "description": "The point's identity, and what a `pick` event and `setPointSelection` name it by. Optional — the engine mints `p<index>` for a point with none, and an index moves when a point is deleted, so send your own if you want to recognise your electrode."
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "World-RAS millimetres."
        },
        "name": {
          "type": "string"
        },
        "state": {
          "enum": ["idle", "selected", "disabled"],
          "description": "Resolved to a colour from stateColors above, including 'idle' (from Tetravox 0.3.12; before that 'idle' was never state-coloured). An explicit `color` on the same point wins. Not the tool selection: any number of points may be selected here, exactly one can be the selection."
        },
        "color": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "radiusMm": {
          "type": "number"
        },
        "group": {
          "type": "string"
        },
        "ordinal": {
          "type": "number"
        },
        "value": {
          "type": "number"
        }
      },
      "required": ["position"]
    }
  }
}
