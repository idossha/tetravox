{
  // Renderer + its module workers: Chromium side. No `node` types here — §5 rule 3 keeps this half
  // away from the filesystem entirely.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client"]
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/renderer/**/*.d.ts",
    // §13.1: the same manifests, from the renderer's side of §5.
    "src/modules/**/*.ts"
  ]
}
