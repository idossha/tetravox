{
  // Playwright-Electron: Node, but `page.evaluate` callbacks are typed against the page's globals.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  // §13.1: a spec that imports a manifest is typechecked against it too — the third of the three
  // tsconfigs a manifest has to satisfy.
  "include": ["e2e/**/*.ts", "playwright.config.ts", "src/modules/**/*.ts"]
}
